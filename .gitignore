# PDFs are LaTeX output almost everywhere in this repo -- EXCEPT the figures,
# which are the vector versions that go into the manuscript. The old blanket
# rule was silently excluding analysis/figures/*.pdf while their .png twins were
# tracked, so the paper-ready copies existed only on one laptop.
*.pdf
!analysis/figures/**/*.pdf

# ---------------------------------------------------------------------------
# Secrets and participant payment data
#
# The bonus CSVs are Prolific IDs paired with payment amounts, written by
# scripts/mark_paid.py and scripts/split_payments.py. Participant identifiers
# do not belong in a public repo, and these regenerate from the exports.
# ---------------------------------------------------------------------------
auth.json
auth.txt
*.key
data/paid.log
/bonuses*.csv
/lobby_bonuses.csv

# ---------------------------------------------------------------------------
# Large regenerable artefacts
#
# Rule of thumb: if a script writes it and re-running that script rebuilds it
# byte-for-byte, it does not go in git. The *inputs* (processed CSVs, configs,
# code) are tracked, so anything below can be rebuilt from a fresh clone.
# ---------------------------------------------------------------------------

# Stimulus pipeline. 4.8 GB of rendered tangrams and embeddings, rebuilt by
# stimuli/generate_tangrams/02_embed_shards.py + 03_merge_shards.py.
stimuli/generate_tangrams/data/*
stimuli/generate_tangrams/outputs/checkpoints/
stimuli/generate_tangrams/outputs/contact_sheets/

# EXCEPT the frozen refactor baseline, which is NOT regenerable.
#
# 00b_baseline_ref.py materialises src/*.py from git HEAD to produce this file.
# HEAD now contains the REFACTORED code (fa6696a1), so re-running it would
# freeze the refactor as its own reference and 01_validate_refactor.py would
# compare the refactor against itself and pass. This 453 KB tensor, frozen on
# 2026-08-17 from 3da1790e, is the only surviving pre-refactor ground truth --
# losing it means losing the ability to prove the pipeline still reproduces the
# published stimuli bit-exactly.
!stimuli/generate_tangrams/data/embeddings/
stimuli/generate_tangrams/data/embeddings/*
!stimuli/generate_tangrams/data/embeddings/_baseline_ref.pt

# Scratch checkout of src/ at a git commit, rebuilt by 00b_baseline_ref.py.
stimuli/generate_tangrams/.pristine_src/

# Per-k sweep summaries, 6-11 MB each and regenerable by 04_sample_sets.py.
# The candidate_sets_*.json files beside them are small and ARE the chosen
# stimulus sets, so they stay tracked -- that is experimental provenance.
stimuli/generate_tangrams/outputs/similarity_results/set_summaries_k*.csv

# Superseded stimulus versions kept locally for reference (172 MB of PNGs).
stimuli/archive/

# Derived embedding artefacts. Rebuilt from processed_data by
# analysis/exp2/03_build_corpus.py + 04_embed.py; ~220 MB of float32 at full
# study size, and obsolete the moment the encoder changes. The similarity pair
# tables under it are small but equally regenerable.
data/embeddings/
*.npy
*.h5

# Empirica bundles are build artefacts (`empirica bundle` regenerates them).
# Keeps ~256 MB blobs out of history. Does not affect the already-tracked
# compShapesV1.tar.zst.
*.tar.zst

# ---------------------------------------------------------------------------
# Participant identifiers -- NEVER COMMITTED
#
# This repo is PUBLIC. Raw Empirica exports carry the Prolific ID twice, in
# player.csv's `urlParams` (participantKey) and `participantIdentifier`, so no
# raw export can be committed regardless of size. They live on this machine and
# in the Empirica exports; git is not a backup for them.
#
# 00_preprocessing.R writes everything identifier-bearing to <run>/private/ --
# the playerID -> prolificID map, the payment lists, the returns list. The rest
# of the processed tree is ULIDs only and is safe to commit or post publicly.
# ---------------------------------------------------------------------------
data/raw_data/
data/processed_data/**/private/
experiments/*/compShapesV1-*.zip
experiments/*/data/

# Belt and braces for the payment files. 00_preprocessing.R and
# split_payments.py both write these into private/ now, but earlier versions
# put them at the top of the run folder, and a Prolific export dropped into a
# run folder by hand is named prolific_*.csv. Matching the names as well as the
# directory means a stale tree, or a hand-copied input, still cannot be added.
payments.csv
returns.csv
bonus*.csv
lobby*.csv
turned_away*.csv
player_bonuses.csv
prolific_*.csv

# Oversized derived files; come home via scp, rebuilt on demand.
data/chat_data/chat_pairwise_similarities.csv
data/processed_data/exp_1/message_similarities.csv

